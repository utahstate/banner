  border-radius: 4px;
}

  body {
    min-height: 100vh;
    margin: 0;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

@media (orientation: landscape) {
    body {
        background-image: url("https://ss-zdevl.banner.usu.edu/img/campus-landscape.jpg");
    }
}

@media (orientation: portrait) {
    body {
        background-image: url("https://ss-zdevl.banner.usu.edu/img/campus-portrait.jpg");
    }
}

@media (orientation: portrait) and (max-width: 320px) {
    body {
        background-image: url("https://ss-zdevl.banner.usu.edu/img/campus-sml.jpg");
    }
}
</style>

